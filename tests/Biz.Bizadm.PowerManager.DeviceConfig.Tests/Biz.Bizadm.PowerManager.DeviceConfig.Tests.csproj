<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <!-- Device(실장비) 테스트는 기본 dotnet test에서 제외한다. 실행 방법은 docs/cli/0003-device-config-개발.md U1 참고 -->
    <TestingPlatformCommandLineArguments>--filter "TestCategory!=Device"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Biz.Bizadm.PowerManager.DeviceConfig\Biz.Bizadm.PowerManager.DeviceConfig.csproj" />
    <!-- Device 카테고리(실장비) 테스트용. Windows에서만 참조한다 -->
    <ProjectReference Include="..\..\src\Biz.Bizadm.PowerManager.DeviceConfig.HostWifi.Runtime.win\Biz.Bizadm.PowerManager.DeviceConfig.HostWifi.Runtime.win.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
