<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <SpaRoot>..\Biz.Bizadm.PowerManager.Client\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="MQTTnet.Server" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biz.Bizadm.PowerManager.Core\Biz.Bizadm.PowerManager.Core.csproj" />
    <ProjectReference Include="..\Biz.Bizadm.PowerManager.Server.Core\Biz.Bizadm.PowerManager.Server.Core.csproj" />
  </ItemGroup>

  <!-- publish 시 프론트엔드를 빌드해 publish 출력의 ClientApp으로 복사한다. CI에서 따로 빌드하면 -p:SkipClientAppBuild=true -->
  <Target Name="PublishClientApp" AfterTargets="Publish" Condition="'$(SkipClientAppBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientAppDist Include="$(SpaRoot)dist\**" />
    </ItemGroup>
    <!-- 같은 출력 폴더에 다시 publish할 때 이전 빌드 파일이 남지 않게 비운다(빌드 성공 후에만 실행) -->
    <RemoveDir Directories="$(PublishDir)ClientApp" />
    <Copy SourceFiles="@(ClientAppDist)" DestinationFolder="$(PublishDir)ClientApp\%(RecursiveDir)" />
  </Target>

</Project>
